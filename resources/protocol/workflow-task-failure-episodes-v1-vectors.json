{
  "contract": "workflow-task-failure-episodes",
  "format_version": 1,
  "status": "source_proposal_not_enabled",
  "normalized_transitions_are_wire_messages": false,
  "proposed_operator_metric_path": "workflow_task_failure_episodes",
  "proposed_fields": {
    "evaluation": "complete | partial | unavailable",
    "count": "Nonnegative count of authoritative open runs with an unresolved episode; null when membership is unavailable.",
    "oldest_started_at": "UTC first accepted failure of the oldest active episode; null for no episodes or any unknown age.",
    "max_age_ms": "Whole elapsed milliseconds at sample_at; zero only for a proven empty set or a known sub-millisecond age; null for unknown/unavailable age.",
    "age_unknown_count": "Number of known active runs without a qualified first-failure clock; null if membership is unavailable."
  },
  "authority": {
    "clock": "Backend-authoritative acceptance/commit clock, persisted atomically with the first accepted failure.",
    "membership": "Existing run/namespace/task/attempt/owner/deadline fences apply before any episode mutation. One open run counts once.",
    "anchor": "Durable per-run first-failure/reset authority or equivalent bounded projection; task ancestry, generic created_at/updated_at and historical task_problem/attempt counts are insufficient.",
    "repeat": "Preserve the first timestamp across accepted failures, retry, claim, heartbeat, replay blocking and automatic delivery/lease recovery.",
    "reset": "Only applied failure-repair writer intent, new committed successful task completion/progress checkpoint, supported recorded waiting acknowledgement completing its task, or closure.",
    "repair_origin": "Explicit writer intent distinguishes failure_episode_reset from delivery_recovery. Event names, repair_count and HTTP success do not establish intent.",
    "noop": "Refused/stale/wrong-owner/wrong-attempt/duplicate/no-effect reports and repair_not_needed neither begin nor clear an episode.",
    "legacy": "Do not invent an anchor for an existing run. Known active membership with unknown age is partial; unqualified membership or an unsupported backend is unavailable.",
    "aggregate": "If any active age is unknown, global oldest_started_at/max_age_ms are null. A known subset is not the oldest age of the full set.",
    "retention": "Closed runs are excluded. Missing active ancestry is incomplete evidence, not age zero. Future pruning must preserve any admitted anchor.",
    "advisory": "Proposed dedicated health check is warning for a positive count, partial or unavailable evaluation; complete zero is OK. This is advisory, with existing HTTP failure rules preserved.",
    "consumer": "Absent family means unavailable, never count zero. Dashboard label is Workflow task failures; an unknown age is displayed as unavailable."
  },
  "adoption_gates": [
    "General/source contract review",
    "Complete Core and Server writer/reset inventory",
    "Existing-run and mixed-version compatibility policy",
    "Backend qualification and downstream consumer review",
    "Normal integration/release authorization"
  ],
