{
  "format": "durable-workflow.activity-retry-policy-vectors",
  "format_version": 1,
  "status": "source-proposal",
  "authority": {
    "product_decision": "https://github.com/durable-workflow/.github/issues/219#issuecomment-6643667500",
    "wire_proposal": "https://github.com/durable-workflow/.github/issues/219#issuecomment-6643231759"
  },
  "scope": {
    "runtime_enabled": false,
    "policy_contract_version": 2,
    "snapshot_version": 2,
    "capability": "activity_retry_delay_override_v1",
    "failure_override_field": "failure.next_retry_delay_seconds",
    "maximum_json_integer": 9007199254740991,
    "generated_default_maximum_interval_seconds": 60,
    "max_attempts_includes_first_attempt": true
  },
  "representation": {
    "policy": "Authored and normalized objects are canonical policy projections for review. They are not a complete activity command or history-event schema.",
    "generation": "Generator parameters describe the fixture schedule only. They do not add worker protocol fields.",
    "time": "Failure and deadline integers are whole seconds in the same fixed fixture epoch. Native adapters must use one authoritative failure sample and their checked timestamp representation.",
    "terminal_classification": "Non-retryable and attempts-exhausted labels describe precedence, not new wire reason strings.",
    "write_count": "Zero means no task, attempt or history mutation. A terminal failure is a valid recorded outcome, not a no-write refusal.",
    "replay": "Recorded outcomes and availability are authoritative. Replay never reruns the current policy against a later clock.",
    "remaining_native_vectors": "Server binds native timestamp overflow, transport non-finite/invalid-JSON input, exact admission fences and retained HTTP acknowledgement shapes to these IDs before producer adoption."
  },
