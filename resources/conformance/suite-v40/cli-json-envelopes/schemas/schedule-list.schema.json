{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://durable-workflow.github.io/cli-json-envelopes/v3/schemas/schedule-list.schema.json",
  "title": "dw schedule:list --json",
  "type": "object",
  "required": ["namespace", "schedules", "next_page_token"],
  "properties": {
    "namespace": { "type": "string" },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["namespace", "schedule_id"],
        "properties": {
          "namespace": { "type": "string" },
          "schedule_id": { "type": "string" },
          "status": { "type": ["string", "null"], "enum": ["active", "paused", null] },
          "workflow_type": { "type": ["string", "null"] },
          "paused": { "type": ["boolean", "null"] },
          "next_fire": { "type": ["string", "null"] },
          "next_fire_at": { "type": ["string", "null"] },
          "last_fire": { "type": ["string", "null"] },
          "last_fire_at": { "type": ["string", "null"] },
          "search_attributes": { "type": ["object", "null"] },
          "created_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "schedule_count": { "type": "integer", "minimum": 0 },
    "next_page_token": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
