{
    "name": "durable-workflow/embedded-http-example",
    "description": "Optional embedded Laravel HTTP hosting example",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "durable-workflow/workflow": "2.5.17",
        "laravel/framework": "12.69.3",
        "laravel/octane": "2.21.0",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0"
    },
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {"php-http/discovery": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
