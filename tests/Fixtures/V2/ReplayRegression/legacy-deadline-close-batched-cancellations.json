  "fixture_schema": "durable-workflow.replay-regression/v1",
  "id": "legacy-deadline-close-batched-cancellations",
  "protocol_version": "1.20",
  "bindings": [
    "php"
  ],
  "consumers": [
    "workflow-fiber-runner"
  ],
  "workflow": {
    "type": "Tests\\Fixtures\\V2\\TestTimeoutCleanupWorkflow",
    "arguments": [
      "complete"
    ],
    "payload_codec": "avro"
  },
  "history": [
    {
      "sequence": 1,
      "event_type": "WorkflowStarted",
      "payload": {},
      "recorded_at": "2026-11-18T00:00:00.000000Z"
    },
    {
      "sequence": 2,
      "event_type": "TimerScheduled",
      "payload": {
        "sequence": 1,
        "delay_seconds": 3600
      },
      "recorded_at": "2026-11-18T00:00:01.000000Z"
    },
    {
      "sequence": 3,
      "event_type": "TimerCancelled",
      "payload": {
        "sequence": 1,
        "delay_seconds": 3600
      },
      "recorded_at": "2026-11-18T00:01:00.000000Z"
    },
    {
      "sequence": 4,
      "event_type": "WorkflowTimedOut",
      "payload": {
        "failure_id": "01kdeadlineclosefailure0001",
        "timeout_kind": "execution_timeout",
        "failure_category": "timeout",
        "message": "Workflow execution deadline expired at 2026-11-18T00:01:00+00:00.",
        "exception_class": "Workflow\\V2\\Exceptions\\WorkflowTimeoutException",
        "execution_deadline_at": "2026-11-18T00:01:00+00:00",
        "run_deadline_at": null
      },
      "recorded_at": "2026-11-18T00:01:30.000000Z"
    }
  ],
  "expected": {
    "completed": false,
    "result": null,
    "commands": []
  },
  "legacy_deadline_close": {
    "issue": "durable-workflow/workflow#1116",
    "execution_timeout_seconds": 60,
    "note": "An ordinary run (no timeout cleanup opt-in) waits on a timer past its execution deadline, and the watchdog's deadline task is never claimed. Before #1116 the watchdog skipped any expired run with a Ready workflow task, so the run stayed open. Now the watchdog closes it with that task: the open timer is cancelled and WorkflowTimedOut recorded, the same history a worker-observed close writes. An oversized close writes this history in bounded batches."
  }
}
